{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Too Many Tabs Open",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Too Many Tabs Open",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/run.ps1"],
      "dependsOn": "Build Too Many Tabs Open",
      "problemMatcher": []
    }
  ]
}
